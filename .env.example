# ─────────────────────────────────────────────
# Memtrail 환경변수 설정 예시
# .env 파일로 복사 후 본인 환경에 맞게 수정하세요
# .env 는 git에 커밋되지 않습니다 (민감 정보)
# 여기 있는 변수만 코드가 실제로 읽습니다 — 미래 계획 변수는 ROADMAP.md 참고
# ─────────────────────────────────────────────

# === 데이터 경로 ===
# 메모리 데이터가 저장되는 루트 디렉토리
# 미설정 시: 코드와 같은 디렉토리 사용
# 마이그레이션 중: 기존 위치 가리켜서 데이터 재사용
MEMEX_DATA_DIR=/path/to/your/memtrail-data

# === 모델 설정 ===
# 임베딩 모델 (한국어 최적화). **바꾸면 전체 재인덱싱이 필요하다** —
# 인덱스는 저장 당시 모델의 벡터라, 질의만 다른 모델로 인코딩하면
# 에러 없이 유사도만 조용히 무의미해진다.
MEMEX_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# (월초 프로필 재합성은 2026-08-15 부터 구독 claude CLI 로 돈다 — 아래 카드 생성
#  항목과 같은 경로라 따로 설정할 것이 없다. MEMEX_OLLAMA_MODEL 은 더 이상 안 읽힌다.)

# === Drive 발행·우편함 (rclone 경유) ===
# 우편함·발행은 폴더 ID 가 아니라 rclone 리모트 경로로 주소를 잡는다.
# 서버에 rclone 을 설치하고 `rclone config` 로 리모트를 만든 뒤 여기 적는다.
# MEMEX_DRIVE_REMOTE=gdrive:ClaudeMemory
# rclone 이 PATH 에 없을 때만 실행파일 경로 지정
# RCLONE_BIN=
# 상주 rclone rcd 주소 (사서 데몬이 서브프로세스 대신 씀 — com.memex.rclone-rcd.plist)
# MEMEX_RCLONE_RC=http://127.0.0.1:5572
# 사서 데몬 폴링 간격 (초)
# MEMEX_MAILBOX_POLL=2
# 처리 시작 표시 — 편지를 집는 즉시 answers/ 에 status:pending 을 먼저 기록한다.
# 끄면 최종 답장이 업로드 한 번만큼 빨라지는 대신, 클라이언트가 "아직 안 왔다" 와
# "결과가 없다" 를 다시 구분 못 한다 (기본 1).
# MEMEX_MAILBOX_PENDING=1

# === 화두 스레드 승격 임계 (scripts/sync_memory_to_drive.py) ===
# 같은 화두태그가 몇 회 이상이면 스레드 승격 후보로 보고할지
# MEMEX_THREAD_THRESHOLD=3

# === SSL 검증 우회 (self-signed 인증서를 쓰는 프록시 환경에서만) ===
# 1 / true / yes 로 옵트인.
# MEMEX_DISABLE_SSL_VERIFY=

# === 작업 기기 → 상시 PC push (scripts/collect_and_push.sh) ===
# 기기가 하나뿐이면 통째로 비워두면 된다.
# 상시 PC 의 ssh 알리아스. tailnet 주소를 ~/.ssh/config 에 적어두고 그 이름을 쓴다.
# MEMTRAIL_SERVER=memtrail-server
# 상시 PC 의 리포 경로 (기본 ~/memtrail)
# MEMTRAIL_SERVER_DIR=~/memtrail
# (맥 서버 전용) 발행 launchd 라벨. 카드 생성 자격증명이 Keychain 이라 SSH 로는 못 읽어서,
# 이 값이 있으면 launchctl kickstart 로 GUI 세션을 경유해 부른다. 리눅스면 비워둘 것.
# MEMTRAIL_SERVER_LAUNCHD=com.memex.drive-sync

# === 카드 생성 (scripts/build_memory_cards.py) ===
# 기본 경로는 **구독으로 쓰는 claude CLI** 다 (`claude -p`). 별도 키·과금 없이 돈다.
# 로그인만 돼 있으면 아래 셋 다 안 건드려도 된다.
#
# **무인 실행이면 장수명 토큰을 권한다.** 로그인 세션은 주기적으로 만료되고
# (2026-08-31 에 28.5일 만에 끊겼다), 맥에선 그 자격증명이 로그인 Keychain 에 있어
# SSH 에서 못 읽는다. GUI 터미널에서 `claude setup-token` 을 한 번 돌려 나온 토큰을
#   $MEMEX_DATA_DIR/config/claude_token   (한 줄, chmod 600, gitignore)
# 에 두면 SSH·launchd·cron 어디서든 산다. 경로를 바꾸려면:
# MEMEX_CLAUDE_TOKEN_FILE=
#
# CLI 가 PATH 에 없을 때만 경로 지정
# CLAUDE_BIN=claude
# 모델 교체 (기본: haiku — 카드 품질에 충분한 것으로 확인됨)
# MEMEX_CARD_MODEL=claude-haiku-4-5-20251001
# CLI 를 못 쓰는 환경(서버 등)에서만 쓰는 폴백. 이쪽은 토큰 과금이다.
# ANTHROPIC_API_KEY=
