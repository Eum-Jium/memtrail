<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  memex 표제 백필 launchd 잡 (macOS 용) — **호출형이다. 스케줄이 없다.**

  card-backfill 과 형제다. 그쪽은 "카드가 없는 대화" 에 카드를 깔고, 이쪽은
  "카드는 있는데 표제가 없는 카드" 에 표제만 깐다 (카드 본문은 안 건드린다).

  왜 launchd 를 경유하나 — card-backfill 과 같은 이유다. 표제 생성도 구독 claude
  CLI 를 쓰는데 macOS 는 그 자격증명이 로그인 Keychain 에 있어 **SSH 세션에서 못
  읽는다** (`claude -p` 가 stdout 에 "Not logged in" 을 뱉고 rc=1). launchd GUI
  도메인(gui/<uid>)에서 돌면 로그인 세션의 Keychain 이 열려 있다.

  이어서 채운다 — 표제가 이미 있는 카드는 건너뛰므로 몇 번을 불러도 된다.
  표제를 못 지으면 그 카드는 표제 줄 없이 남고(사서가 파일명으로 폴백한다)
  다음 실행에서 다시 잡힌다. 빈 표제를 쓰는 일은 없다.

  설치법 — USERNAME 네 곳을 실제 값으로 바꾼 뒤:
    cp scripts/com.memex.card-title.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.memex.card-title.plist
  실행:   launchctl kickstart -k gui/$(id -u)/com.memex.card-title
  진행:   tail -f ~/memtrail/logs/launchd_card_title.log
  중단:   launchctl kill TERM gui/$(id -u)/com.memex.card-title
  해제:   launchctl bootout gui/$(id -u)/com.memex.card-title

  RunAtLoad 도 StartInterval 도 없다 — 구독 호출을 쓰는 잡이라 저절로 돌지 않는다.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.memex.card-title</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/USERNAME/memtrail/.venv/bin/python</string>
        <string>/Users/USERNAME/memtrail/scripts/build_memory_cards.py</string>
        <string>--titles</string>
        <string>--jobs</string>
        <string>8</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/USERNAME/memtrail</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- claude 가 여기 있다. 빠지면 표제가 통째로 실패한다. -->
        <key>PATH</key>
        <string>/Users/USERNAME/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>MEMEX_DATA_DIR</key>
        <string>/Users/USERNAME/memtrail</string>
        <!-- 파이프로 나가면 블록 버퍼링돼 진행 로그가 한참 늦게 뜬다. -->
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/USERNAME/memtrail/logs/launchd_card_title.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/memtrail/logs/launchd_card_title.err</string>
</dict>
</plist>
